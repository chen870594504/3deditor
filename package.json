{
  "name": "@chen870594504/3deditor",
  "version": "0.1.0",
  "description": "基于 Vue3 + TresJS 的可嵌入 3D 场景插件",
  "type": "module",
  "license": "MIT",
  "author": "陈盛君 <870594504@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen870594504/3deditor.git"
  },
  "keywords": [
    "vue3",
    "three",
    "tresjs",
    "pinia",
    "3d",
    "scene",
    "editor",
    "gltf",
    "floorplan"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build --mode lib",
    "build:only": "vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm build:only && pnpm smoke",
    "prepublishOnly": "pnpm build && pnpm smoke"
  },
  "peerDependencies": {
    "@tresjs/cientos": "^5.9.0",
    "@tresjs/core": "^5.9.0",
    "pinia": "^4.0.3",
    "three": ">=0.170.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tresjs/cientos": "^5.9.0",
    "@tresjs/core": "^5.9.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/server-renderer": "^3.5.43",
    "pinia": "^4.0.3",
    "sass-embedded": "^1.104.1",
    "three": "^0.186.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
